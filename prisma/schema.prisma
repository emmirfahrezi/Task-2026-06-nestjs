generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Divisi {
  id    Int    @id @default(autoincrement())
  name  String @db.VarChar(50)
  users User[]

  @@map("divisi")
}

model User {
  id        Int    @id @default(autoincrement())
  name      String @db.VarChar(50)
  divisi_id Int
  divisi    Divisi @relation(fields: [divisi_id], references: [id])

  @@map("users")
}
